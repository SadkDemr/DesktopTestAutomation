<Window x:Class="SampleWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AutomationProperties.AutomationId="MainWindow"
        Title="Müşteri Yönetimi" Width="760" Height="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <TextBlock x:Name="WelcomeText"
                   AutomationProperties.AutomationId="WelcomeText"
                   DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

        <TextBlock x:Name="StatusText"
                   AutomationProperties.AutomationId="StatusText"
                   DockPanel.Dock="Bottom" Margin="0,12,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Form -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Ad Soyad" />
                <TextBox x:Name="NameTextBox" AutomationProperties.AutomationId="NameTextBox" />

                <TextBlock Text="E-posta" />
                <TextBox x:Name="EmailTextBox" AutomationProperties.AutomationId="EmailTextBox" />

                <TextBlock Text="Şehir" />
                <ComboBox x:Name="CityComboBox"
                          AutomationProperties.AutomationId="CityComboBox"
                          Margin="0,4,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="İstanbul" />
                    <ComboBoxItem Content="Ankara" />
                    <ComboBoxItem Content="İzmir" />
                </ComboBox>

                <CheckBox x:Name="IsActiveCheckBox"
                          AutomationProperties.AutomationId="IsActiveCheckBox"
                          Content="Aktif müşteri" IsChecked="True" Margin="0,0,0,12" />

                <Button x:Name="AddButton"
                        AutomationProperties.AutomationId="AddButton"
                        Content="Ekle" HorizontalAlignment="Left"
                        Click="AddButton_Click" />
            </StackPanel>

            <!-- Liste -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="DeleteButton"
                            AutomationProperties.AutomationId="DeleteButton"
                            Content="Seçiliyi sil" IsEnabled="False"
                            Click="DeleteButton_Click" />
                    <TextBlock x:Name="CustomerCountText"
                               AutomationProperties.AutomationId="CustomerCountText"
                               VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid x:Name="CustomersGrid"
                          AutomationProperties.AutomationId="CustomersGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          SelectionChanged="CustomersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ad Soyad" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="E-posta" Binding="{Binding Email}" Width="*" />
                        <DataGridTextColumn Header="Şehir" Binding="{Binding City}" Width="Auto" />
                        <DataGridTextColumn Header="Aktif" Binding="{Binding IsActiveText}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
