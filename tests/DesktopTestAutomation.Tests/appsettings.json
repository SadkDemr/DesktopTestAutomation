{
  // Test edilecek uygulamanın exe yolu (ör. "C:\\Program Files\\Firma\\Uygulama.exe").
  // Boş bırakılırsa kendi uygulamanıza ait testler "Ignored" olarak atlanır.
  // Örnek uygulama (SampleApp) testleri bu ayardan bağımsız çalışır.
  "AppPath": "",

  // true : Uygulama açıksa yeniden başlatılmaz, açık olana bağlanılır. Kapalıysa bir kez açılır.
  //        Test bitince uygulama KAPATILMAZ; sonraki testler aynı pencereden devam eder.
  // false: Her test (veya fixture) uygulamayı yeniden açar ve bitince kapatır (en izole yöntem).
  "AttachToRunningApp": true,

  "StartupTimeoutSeconds": 20,
  "DefaultTimeoutSeconds": 10,
  "ScreenshotDirectory": "Screenshots"
}
